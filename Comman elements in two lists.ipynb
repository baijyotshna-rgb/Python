   "source": [
    "list1 = list(map(int, input(\"Enter first list: \").split()))\n",
    "list2 = list(map(int, input(\"Enter second list: \").split()))\n",
    "\n",
    "common = []\n",
    "\n",
    "for num in list1:\n",
    "    if num in list2 and num not in common:\n",
    "        common.append(num)\n",
    "\n",
    "print(\"Common elements =\", common)"
   ]
