   "source": [
    "numbers = list(map(int, input(\"Enter numbers: \").split()))\n",
    "\n",
    "unique = []\n",
    "\n",
    "for num in numbers:\n",
    "    if num not in unique:\n",
    "        unique.append(num)\n",
    "\n",
    "print(\"List without duplicates =\", unique)"
   ]
  }
